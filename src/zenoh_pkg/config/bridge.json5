{
  plugins: {
    ros2dds: {
      allow: {
        // Robot -> Main
        publishers: [
          "^/battery_state$",
          "^/logitle_pose$"
        ],

        // Main -> Robot
        subscribers: [
          "^/cmd_vel$"
        ],

        // Main -> Robot Service
        service_servers: [],

        service_clients: [],

        // Main -> Robot Action
        action_servers: [
          "^/follow_waypoints$",
          "^/aruco_align_and_correct$",
          "^/precision_dock$"
        ],

        action_clients: []
      }
    }
  },

  scouting: {
    multicast: {
      enabled: false
    },

    gossip: {
      enabled: false
    }
  }
}