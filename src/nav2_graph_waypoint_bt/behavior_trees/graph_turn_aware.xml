<!-- A+B: segment goal processing at direction changes, preserve 1Hz per-segment replanning -->
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="6" name="NavigateRecovery">
      <Sequence name="NavigateWithTurnStops">
        <ControllerSelector selected_controller="{selected_controller}"
                            default_controller="FollowPath" topic_name="controller_selector"/>
        <PlannerSelector selected_planner="{selected_planner}"
                         default_planner="ThetaStar" topic_name="planner_selector"/>
        <TurnSegmentControl input_goals="{goals}" remaining_goals="{goals}"
                            segment_goals="{segment_goals}" segment_id="{segment_id}"
                            turn_angle_deg="15.0" min_leg_length="0.07">
          <PipelineSequence name="NavigateSegmentWithReplanning">
            <RateController hz="20.0">
              <PruneGraphGoals input_goals="{segment_goals}" output_goals="{segment_goals}"
                               segment_id="{segment_id}" near_radius="0.04"
                               lateral_tolerance="0.06" max_pass_distance="0.12"
                               pass_margin="0.0" global_frame="map"
                               robot_base_frame="base_footprint"/>
            </RateController>
            <RateController hz="1.0">
              <RecoveryNode number_of_retries="1" name="ComputePathThroughPoses">
                <ComputePathThroughPoses goals="{segment_goals}" path="{path}"
                                         planner_id="{selected_planner}"
                                         error_code_id="{compute_path_error_code}" server_timeout="1000"/>
                <Sequence>
                  <WouldAPlannerRecoveryHelp error_code="{compute_path_error_code}"/>
                  <ClearEntireCostmap service_name="global_costmap/clear_entirely_global_costmap"/>
                </Sequence>
              </RecoveryNode>
            </RateController>
            <RecoveryNode number_of_retries="1" name="FollowPath">
              <FollowPath path="{path}" controller_id="{selected_controller}"
                          error_code_id="{follow_path_error_code}"/>
              <Sequence>
                <WouldAControllerRecoveryHelp error_code="{follow_path_error_code}"/>
                <ClearEntireCostmap name="ClearLocalCostmap-Context" service_name="local_costmap/clear_entirely_local_costmap"/>
              </Sequence>
            </RecoveryNode>
          </PipelineSequence>
        </TurnSegmentControl>
      </Sequence>
      <Sequence>
        <Fallback>
          <WouldAControllerRecoveryHelp error_code="{follow_path_error_code}"/>
          <WouldAPlannerRecoveryHelp error_code="{compute_path_error_code}"/>
        </Fallback>
        <ReactiveFallback name="RecoveryFallback">
          <GoalUpdated/>
          <RoundRobin name="RecoveryActions">
            <Sequence name="ClearingActions">
              <ClearEntireCostmap name="ClearLocalCostmap-Subtree" service_name="local_costmap/clear_entirely_local_costmap"/>
              <ClearEntireCostmap name="ClearGlobalCostmap-Subtree" service_name="global_costmap/clear_entirely_global_costmap"/>
            </Sequence>
            <Spin spin_dist="1.57" error_code_id="{spin_error_code}"/>
            <Wait wait_duration="5.0"/>
          </RoundRobin>
        </ReactiveFallback>
      </Sequence>
    </RecoveryNode>
  </BehaviorTree>
</root>
