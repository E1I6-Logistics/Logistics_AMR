# Goal
int32 marker_id

float32 timeout_sec 20.0
float32 align_timeout_sec 10.0
float32 correct_timeout_sec 10.0

float32 target_z 0.32
float32 x_tolerance 0.025
float32 z_tolerance 0.035
float32 z_min_stop 0.25
float32 stable_sec 0.5

float32 max_linear 0.015
float32 max_angular 0.08
float32 kx 2.0
float32 kz 0.4

bool apply_correction true
int32 required_samples 15
bool check_yaw true
float32 expected_base_yaw_deg -90.0
float32 yaw_tolerance_deg 4.0

---
# Result
int32 RESULT_SUCCESS=0
int32 RESULT_TIMEOUT=1
int32 RESULT_CANCELED=2
int32 RESULT_MARKER_LOST=3
int32 RESULT_ALIGN_FAILED=4
int32 RESULT_CORRECTION_FAILED=5
int32 RESULT_INVALID_GOAL=6

bool success
int32 result_code
string message

bool align_success
bool correction_success

float32 final_marker_x
float32 final_marker_z
float32 final_x_error
float32 final_z_error

int32 correction_result_code
string correction_message
float32 map_base_x
float32 map_base_y
float32 map_base_yaw_deg
float32 map_base_xy_std
float32 map_base_yaw_std_deg

---
# Feedback
string state
bool marker_visible

float32 latest_marker_x
float32 latest_marker_z
float32 latest_x_error
float32 latest_z_error

float32 command_linear_x
float32 command_angular_z
float32 aligned_duration_sec

int32 accepted_samples
int32 rejected_samples
string correction_state
