float32 correct_timeout_sec 10.0

float32 target_x 0.0
float32 target_z 0.0
float32 x_tolerance 0.005
float32 z_tolerance 0.007
float32 z_min_stop 0.25
float32 stable_sec 0.4

float32 max_linear 0.030
float32 max_angular 0.04
float32 min_angular 0.020
float32 kx 0.8
float32 kz 1.2
bool check_wall_yaw true
float32 wall_yaw_tolerance_deg 2.0
float32 kyaw 0.6

bool apply_correction true
int32 required_samples 15
bool check_yaw true
float32 expected_base_yaw_deg -87.0
float32 yaw_tolerance_deg 3.0

