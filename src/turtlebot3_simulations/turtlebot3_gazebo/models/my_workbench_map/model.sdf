<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="workbench_station">
    <!-- 주변 환경 구조물이므로 고정(Static) 상태로 설정 -->
    <static>true</static>
    
    <link name="workbench_link">
      
      <!-- 1. 시각적으로 보여지는 부분 (Visual) -->
      <visual name="workbench_visual">
        <geometry>
          <mesh>
            <uri>model://my_workbench_map/meshes/my_map.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <!-- 양면 렌더링 활성화 -->
        <material>
          <ambient>0.6 0.6 0.6 1</ambient>
          <diffuse>0.6 0.6 0.6 1</diffuse>
          <double_sided>true</double_sided>
        </material>
      </visual>

      <!-- 2. 물리적 충돌 영역 (Collision) -->
      <collision name="workbench_collision">
        <geometry>
          <mesh>
            <uri>model://my_workbench_map/meshes/my_map.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </collision>
      

    </link>
  </model>
</sdf>